          "high"
        ],
        "type": "string",
        "default": "high"
      },
      "output_format": {
        "enum": [
          "mp4",
          "mov"
        ],
        "type": "string",
        "default": "mp4"
      },
      "generate_audio": {
        "type": "boolean",
        "default": true
      }
    },
    "additionalProperties": false
  },
