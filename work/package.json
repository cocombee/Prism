{
  "name": "prism-foundry",
  "version": "0.1.0",
  "description": "A local-first visual AI workflow studio for macOS",
  "main": "out/main/index.js",
  "author": "Cocombee",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test": "vitest run",
    "test:native": "node scripts/run-native-tests.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@xyflow/react": "^12.10.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3",
    "simple-icons": "^16.27.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.cocombees.prismfoundry",
    "productName": "Prism Foundry",
    "asar": true,
    "directories": {
      "output": "../outputs/build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "prismflow",
        "name": "Prism Foundry Project",
        "description": "Editable Prism Foundry workflow project",
        "role": "Editor"
      },
      {
        "ext": "prismasset",
        "name": "Prism Foundry Asset",
        "description": "Portable Prism Foundry asset bundle",
        "role": "Editor"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Prism Foundry ${version}",
      "artifactName": "Prism-Foundry-${version}-${arch}.${ext}",
      "backgroundColor": "#111019",
      "window": {
        "width": 600,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 205,
          "type": "file"
        },
        {
          "x": 430,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
